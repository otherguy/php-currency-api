# EditorConfig is awesome: http://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.md]
indent_size = 1

[*.php]
indent_size = 1

[*.toml]
indent_size = 2

[*.{yml,yaml,json,neon}]
indent_size = 2
